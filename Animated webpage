<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animated Webpage</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background: linear-gradient(to right, #6a11cb, #2575fc);
            color: white;
        }

        /* Animated heading */
        h1 {
            margin-top: 50px;
            animation: fadeIn 3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Button animation */
        button {
            padding: 10px 20px;
            font-size: 16px;
            background: #ff9800;
            border: none;
            color: white;
            cursor: pointer;
            transition: transform 0.3s, background 0.3s;
        }

        button:hover {
            background: #e68900;
            transform: scale(1.1);
        }

        /* Moving box animation */
        .box {
            width: 100px;
            height: 100px;
            background: yellow;
            margin: 40px auto;
            animation: moveBox 4s infinite alternate;
        }

        @keyframes moveBox {
            from { transform: translateX(0); }
            to { transform: translateX(200px); }
        }
    </style>
</head>

<body>

    <h1>Welcome to Animated Page</h1>

    <button onclick="showAlert()">Click Me</button>

    <div class="box"></div>

    <script>
        function showAlert() {
            alert("Button Clicked!");
        }
    </script>

</body>
</html>
