<!DOCTYPE html>
<html>
<head>
    <title>House Sketch</title>
    <style>
        body {
            background-color: #f0f0f0;
        }

        .house {
            position: relative;
            width: 200px;
            height: 150px;
            background-color: #ffcc99;
            margin: 100px auto;
            border: 2px solid black;
        }

        .roof {
            position: absolute;
            top: -100px;
            left: -20px;
            width: 0;
            height: 0;
            border-left: 120px solid transparent;
            border-right: 120px solid transparent;
            border-bottom: 100px solid brown;
        }

        .door {
            position: absolute;
            bottom: 0;
            left: 80px;
            width: 40px;
            height: 70px;
            background-color: #663300;
            border: 2px solid black;
        }

        .window {
            position: absolute;
            width: 40px;
            height: 40px;
            background-color: lightblue;
            border: 2px solid black;
        }

        .window.left {
            top: 30px;
            left: 20px;
        }

        .window.right {
            top: 30px;
            right: 20px;
        }
    </style>
</head>
<body>

<div class="house">
    <div class="roof"></div>
    <div class="door"></div>
    <div class="window left"></div>
    <div class="window right"></div>
</div>

</body>
</html>
