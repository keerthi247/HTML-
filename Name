<!DOCTYPE html>
<html>
<head>
    <title>Animated Name</title>
    <style>
        body {
            background-color: black;
            color: lime;
            font-family: monospace;
            text-align: center;
        }

        pre {
            font-size: 20px;
            animation: glow 1s infinite alternate;
        }

        @keyframes glow {
            from { color: lime; }
            to { color: cyan; }
        }
    </style>
</head>
<body>

    <h2>My Name</h2>

    <pre>
K   K   EEEEE   EEEEE
K  K    E       E
K K     EEEE    EEEE
K  K    E       E
K   K   EEEEE   EEEEE
    </pre>

</body>
</html>
