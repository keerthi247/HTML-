<!DOCTYPE html>
<html>
<body>

<h2>Canvas Example</h2>

<canvas id="myCanvas" width="300" height="200" style="border:1px solid black;">
</canvas>

<script>
var c = document.getElementById("myCanvas");
var ctx = c.getContext("2d");

ctx.fillStyle = "blue";
ctx.fillRect(50, 50, 150, 100);
</script>

</body>
</html>
